# ==============================================================================
# Hi5 Spring Boot Backend Environment Variables
# Copy this file to .env or pass these as environment variables
# ==============================================================================

# Database
MONGODB_URI=mongodb://localhost:27017/hi5

# Server Port
SERVER_PORT=8080

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# Mail Server Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# OAuth2 Authentication
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth2 Frontend Redirects
OAUTH2_ERROR_REDIRECT_URL=http://localhost:3000/error
OAUTH2_LOGIN_REDIRECT_URL=http://localhost:3000/login/oauth2?token=
OAUTH2_SIGNUP_REDIRECT_URL=http://localhost:3000/signup/oauth2?token=

# Token Secrets & Expirations
TOKEN_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
TOKEN_EXPIRATION=60 minutes

IDENTIFICATION_TOKEN_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
IDENTIFICATION_TOKEN_EXPIRATION=10 minutes

OTP_EXPIRATION=5 minutes
